{
  "name": "searchparty",
  "version": "0.1.1-rc.0",
  "description": "Crawl a website and preview every page's SEO metadata and social images in a realtime dashboard.",
  "type": "module",
  "module": "index.ts",
  "bin": {
    "searchparty": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "ui/dist"
  ],
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run index.ts",
    "dev:ui": "cd ui && bun run dev",
    "build:ui": "cd ui && bun install && bun run build",
    "build": "bun run sync:types && bun run build:ui",
    "test": "bun test",
    "sync:types": "bun run scripts/sync-ui-types.ts",
    "check:types": "bun run scripts/sync-ui-types.ts --check",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "check": "bun run workflows:check && bun run check:types && bun run typecheck && bun test && bun run build",
    "release": "bun scripts/release.ts",
    "workflows": "bun ci/generate.ts",
    "workflows:check": "bun ci/generate.ts --check"
  },
  "keywords": [
    "seo",
    "crawler",
    "sitemap",
    "open-graph",
    "metadata",
    "dashboard",
    "cli"
  ],
  "author": "Lucas Knight",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "image-size": "^2.0.2",
    "node-html-parser": "^7.0.1",
    "puppeteer-core": "^25.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "packageManager": "bun@1.3.11",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aussieljk/searchparty.git"
  }
}
